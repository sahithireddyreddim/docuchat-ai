# ============================================================
# DocuChat AI — Environment Variables
# Copy this file to .env in the backend/ directory
# ============================================================

# ---- LLM (REQUIRED) ----------------------------------------
# Get your free API key at: https://console.groq.com
# No credit card needed. Free tier: 6000 req/day, 500K tokens/day
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Choose model (free options):
#   llama-3.1-8b-instant   — Fastest, great for most use cases
#   llama-3.3-70b-versatile — Smarter, slightly slower
#   gemma2-9b-it            — Google's model, good for multilingual
GROQ_MODEL=llama-3.1-8b-instant

# ---- Security ------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# ---- App Settings -------------------------------------------
DEBUG=false
APP_NAME=DocuChat AI

# ---- File Upload --------------------------------------------
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

# ---- Vector Store -------------------------------------------
CHROMA_DIR=chroma_db

# ---- RAG Settings -------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3

# ---- CORS (update for production) ---------------------------
# Add your deployed frontend URL here for production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
